{"schemaVersion":2,"title":"Design System: After Hours","extensions":{"reading":{"widthDesktop":"400px","bodyDesktop":"19px/1.5","bodyMobile":"18px/1.5","headingDesktop":"34px/1.12","headingMobile":"30px/1.12","monitorBackground":"#142b31","monitorInk":"#f8e9ce","notebookBackground":"#f1dfb9","notebookBinding":"#315975","letterBackground":"#eedfc5","letterEdge":"#a64a39","stickyReturn":true,"compactFlow":"max-width:1000px or max-height:600px","phoneRoom":"clamp(320px,43svh,400px)","phoneHotspots":"use direct shelf, no duplicate labels","closeAllViewports":true},"scene":{"cameraDesktop": {"fov": 34, "position": [5.3, 5.5, 8]}, "cameraMobile": {"fov": 62, "position": [1.8, 6, 8.8]}, "lookAt": [0, 2.9, -0.35], "hemisphereIntensity": 3.2, "warmDirectionalFill": 2.2, "taskLampCastsShadow": false, "readingEyebrow": false},"shadows":[{"name":"note","value":"0 16px 48px #06111c80","purpose":"Separate the readable sheet from the room"},{"name":"hotspot","value":"0 5px 16px #08152170","purpose":"Lift actions off physical surfaces"}],"motion":[{"name":"server-led","value":"70ms render interval","purpose":"Small bounded ambient LED pulse, pause and reduced-motion opt-out"}],"breakpoints":[{"name":"mobile-inspect","value":"700px"}]},"components":[{"name":"Object hotspot","kind":"button","refersTo":"hotspot","description":"Native keyboard-accessible object inspection","html":"<button class=\"ds-hotspot\">Notebook</button>","css":".ds-hotspot{font:16px sans-serif;border:1px solid #c5a36c;background:#182b3e;color:#fff0ce;padding:5px 11px;border-radius:20px;box-shadow:0 5px 16px #08152170;cursor:pointer}.ds-hotspot:hover{background:#f2d49b;color:#172c40}.ds-hotspot:focus-visible{outline:3px solid #ffe185;outline-offset:5px}"},{"name":"Reading note","kind":"custom","refersTo":"note","description":"Object-specific native DOM: monitor for About/Curiosity, blue-bound notebook for Approach, correspondence for Contact; nonmodal, sticky return and compact document flow","html":"<section class=\"ds-note\"><h2>Hello, I’m Victor.</h2><p>Software developer and problem solver.</p></section>","css":".ds-note{background:#142b31;color:#f8e9ce;padding:0 30px 24px;border:8px solid #202d32;border-bottom-width:18px;border-radius:4px;font:19px/1.5 Alegreya,sans-serif;box-shadow:0 16px 48px #06111c80}.ds-note h2{font:34px/1.12 Vollkorn,serif;margin:26px 0 22px}"},{"name":"Shelf action","kind":"nav","description":"Direct professional-information access","html":"<button class=\"ds-shelf\"><span>Monitor</span>Meet Victor</button>","css":".ds-shelf{background:#12283b;color:#f8e9ce;border:0;padding:7px 30px;font:21px sans-serif;text-align:left;cursor:pointer}.ds-shelf span{display:block;color:#bdcdd5;font-size:14px;margin-bottom:4px}.ds-shelf:hover{color:#ffe185}.ds-shelf:focus-visible{outline:3px solid #ffe185;outline-offset:5px}"}],"narrative":{"northStar":"After Hours","overview":"A small evening workshop carries the site. Denim walls absorb light; oak and brass collect the task lamp's warmth. The room is an illustrative authored scene, not a reconstruction of Victor's home.","keyCharacteristics":["material depth","familiar objects","direct reading","restrained ambient motion"],"dos":["Keep all professional information reachable without camera movement","Label the room as imagined and the server as illustrative"],"donts":["Invent clients, deployments, metrics or contact delivery","Claim technical test success establishes reference-level craft acceptance"]}}